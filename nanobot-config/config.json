{
  "providers": {
    "openrouter": {
      "apiKey": "${OPENROUTER_API_KEY}"
    }
  },
  "agents": {
    "defaults": {
      "model": "deepseek/deepseek-v3-0324:free",
      "provider": "openrouter",
      "workspace": "/app/nanobot-config"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": [
        "*"
      ]
    }
  }
}
