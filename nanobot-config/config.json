{
  "providers": {
    "openai": {
      "apiKey": "${SAMBANOVA_API_KEY}",
      "apiBase": "https://api.sambanova.ai/v1"
    }
  },
  "agents": {
    "defaults": {
      "provider": "openai",
      "model": "DeepSeek-R1",
      "workspace": "/app/nanobot-config"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": [
        "*"
      ]
    }
  }
}
