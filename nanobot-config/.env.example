# NanoBot Environment Variables
# Set these as Railway Variables (or Replit Secrets for local dev).
# Never hardcode values here.

# ─── Required ─────────────────────────────────────────────────────────────────

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Telegram bot token — @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ─── Optional — Web Search & News ─────────────────────────────────────────────

# Tavily AI Search — https://tavily.com (free tier: 1000 req/month)
TAVILY_API_KEY=

# NewsAPI — https://newsapi.org (free tier: 100 req/day, articles up to 1 month)
NEWSAPI_KEY=

# Brave Search API — https://search.brave.com/app/keys (free tier: 2000 req/month)
BRAVE_API_KEY=

# ─── Free tools (no key needed) ───────────────────────────────────────────────
# weather    → wttr.in + open-meteo.com
# wikipedia  → wikipedia.org API
# polymarket → gamma-api.polymarket.com
